{
  "expo": {
    "name": "VidTalk",
    "slug": "vidtalk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "vidtalk",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vidtalk.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.vidtalk.app",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow VidTalk to access your camera for recording video comments."
        }
      ],
      [
        "expo-secure-store",
        {
          "iosAccessGroup": "com.vidtalk.app"
        }
      ],
      "expo-splash-screen",
      "expo-video"
    ],
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#E6F4FE"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d56ff209-3b11-420b-a98c-fe57b20a2660"
      }
    },
    "owner": "darshankumar27"
  }
}
